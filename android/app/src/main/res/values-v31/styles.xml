<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ (API 31+) usa a Splash Screen API do sistema, que ignora
         android:background do tema base (values/styles.xml) — sem esse
         override específico, o Android mostra a splash padrão dele mesmo
         (fundo preto + ícone do launcher pequeno) antes da splash do
         Capacitor aparecer. Aqui igualamos ao fundo branco já usado na
         splash do Capacitor (ver resources/README.md) pra não ter flash
         preto nem troca de cor entre as duas telas. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
